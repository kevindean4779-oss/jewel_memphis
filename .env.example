# Copy to .env.local and fill in. All values are public in the browser bundle.

# Shared orders (Supabase). Run supabase/schema.sql once in your project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Live gold, silver and platinum spot prices (goldapi.io free tier).
VITE_GOLDAPI_KEY=
# Hours before live prices are refreshed. The free tier allows about 100 requests a month.
VITE_RATE_TTL_HOURS=24
