# Copy to .env.local for `npm run dev`, and add the same values in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# Live metal prices (server only)
METALS_API_KEY=
# metalpriceapi | metals-api | metals-dev | goldapi | gold-api
METALS_API_PROVIDER=metalpriceapi

# Supabase (server only — do NOT prefix with VITE_, or the key ships to browsers)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
